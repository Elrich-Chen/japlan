# Copy to .env for local wrangler. Secrets in prod via `wrangler secret put`.
# [REQUIRED] = core path needs it for live demos.
# [OPTIONAL] = blank is safe; fail-open / fixture path documented below.

# ─── Linq (src/linq/) ───────────────────────────────────────────────────────
# [REQUIRED for live iMessage] Partner API key for outbound send.
LINQ_API_KEY=
# [REQUIRED] Sandbox/production Linq line in E.164 (the "from" number).
LINQ_FROM_NUMBER=
# [OPTIONAL] Your personal phone for local send spikes (E.164).
LINQ_TEST_TO_NUMBER=
# [REQUIRED for live webhooks] Signing secret from webhook subscription create.
# Blank → local/dev needs LINQ_SKIP_VERIFY=1.
LINQ_WEBHOOK_SECRET=
# [OPTIONAL] Set to 1 only for local fixture POSTs / pre-webhook. Never in production.
LINQ_SKIP_VERIFY=0
# [OPTIONAL] Base URL override for Linq Partner API.
LINQ_API_BASE_URL=

# ─── Cloudflare ─────────────────────────────────────────────────────────────
# Local: wrangler.dev uses .dev.vars / .env. Deployed: dashboard / secret put.
# No extra vars required for Agent SQL in the skeleton.

# ─── Browserbase (src/browser/) ─────────────────────────────────────────────
# [OPTIONAL] Blank → live Stagehand skipped; searchActivities serves data/
# fixtures, then canned ActivityCandidate[]. Demo never dies.
BROWSERBASE_API_KEY=
BROWSERBASE_PROJECT_ID=
# [OPTIONAL] Stagehand / session knobs later.

# ─── Model: Read seam (src/ai/seams/read.ts) — PIPELINE.md ──────────────────
# [OPTIONAL for local] Blank → fixture classify/extract under data/.
MODEL_READ_API_KEY=
MODEL_READ_MODEL=
MODEL_READ_BASE_URL=

# ─── Model: Compose seam (src/ai/seams/compose.ts) — PIPELINE.md ────────────
# [OPTIONAL for local] Blank → canned friend-voice templates.
# Do NOT alias to MODEL_READ_* even if same vendor.
MODEL_COMPOSE_API_KEY=
MODEL_COMPOSE_MODEL=
MODEL_COMPOSE_BASE_URL=

# ─── Composio (optional #4 — do not chase) ──────────────────────────────────
# [OPTIONAL] Blank → composio module stays dormant / absent.
COMPOSIO_API_KEY=
